# Golaks API - Environment Configuration
# Copy this file to .env and update with your values

# App Configuration
APP_NAME="Golaks API"
APP_VERSION="1.0.0"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul

# Security
JWT_SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Central Auth Database
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_NAME=golaks_auth
AUTH_DB_USER=root
AUTH_DB_PASS=
AUTH_DB_CHARSET=utf8mb4

# Tenant Databases
# App Tenant
TENANT_APP_DB_HOST=localhost
TENANT_APP_DB_PORT=3306
TENANT_APP_DB_NAME=golaks_app
TENANT_APP_DB_USER=root
TENANT_APP_DB_PASS=
TENANT_APP_DISPLAY_NAME="Golaks Ana Sistem"

# Test Tenant
TENANT_TEST_DB_HOST=localhost
TENANT_TEST_DB_PORT=3306
TENANT_TEST_DB_NAME=golaks_test
TENANT_TEST_DB_USER=root
TENANT_TEST_DB_PASS=
TENANT_TEST_DISPLAY_NAME="Test Ortamı"

# Demo Tenant
TENANT_DEMO_DB_HOST=localhost
TENANT_DEMO_DB_PORT=3306
TENANT_DEMO_DB_NAME=golaks_demo
TENANT_DEMO_DB_USER=root
TENANT_DEMO_DB_PASS=
TENANT_DEMO_DISPLAY_NAME="Demo Ortamı"

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Tenant-ID,X-Device-ID

# API Configuration
API_PREFIX=/api
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Email Configuration (for forgot password, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@golaks.com
MAIL_FROM_NAME="Golaks"

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
LOG_MAX_FILES=30

# Session
SESSION_LIFETIME=120
SESSION_DRIVER=file
